DISCORD_TOKEN=
GROQ_API_KEY=

# Production Groq chat model. Override with /model in Discord, or change this.
GROQ_MODEL=openai/gpt-oss-120b

# Optional. Set this to your server id so slash commands show up immediately.
# Leave blank to sync globally (can take up to an hour).
DISCORD_GUILD_ID=

GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.7
HISTORY_TURNS=8

# Live web search. Works with openai/gpt-oss-120b, openai/gpt-oss-20b,
# and openai/gpt-oss-safeguard-20b. The model searches only when the question needs it.
WEB_SEARCH=true

SYSTEM_PROMPT=You are a helpful Discord assistant. Answer the user's question directly, in a tone that fits a chat server. Keep replies focused unless the user asks for detail. Format with Discord markdown only: # ## and ### headings, -# subtext, **bold**, *italics*, __underline__, ~~strike~~, `code`, fenced code blocks, - lists, > quotes, and [label](url) links. Do not use markdown tables, HTML, or ![image](url) syntax. When a question depends on news, prices, weather, sports, releases, or other live facts, search the web and include the source links you used. For coding help, opinions, and general knowledge, answer directly.
